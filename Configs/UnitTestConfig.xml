<?xml version="1.0" encoding="utf-8"?>

<Config>
  <log>
    <verboseLogging>true</verboseLogging>
  </log>

  <warningsAllowed>
    <!-- Intermittent vanilla bug -->
    <li>Object with load ID Thing_[^\s]+ is referenced \(xml node name: .+?\) but is not deep-saved\. This will cause errors during loading\.</li>
    <!-- GenStep_BaseRuins fails to find valid location on small maps, but fails safely -->
    <li>did not find any valid rects to generate ruins in for bounds</li>
  </warningsAllowed>

  <errorsAllowed>
    <!-- Intermittent vanilla bug -->
    <li>^Faction .+? contains ideo .+? which was removed!$</li>
  </errorsAllowed>

  <preTestActions>
    <li>Vehicles.TestActions.RefocusMap</li>
  </preTestActions>
  
  <postTestActions>
    <li>Vehicles.TestActions.EmptyWorldAndMapOfVehicles</li>
    <li>Vehicles.TestActions.ClearVanillaVehiclesExpandedTrackerCache</li>
  </postTestActions>
</Config>