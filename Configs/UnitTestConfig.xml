<?xml version="1.0" encoding="utf-8"?>

<Config>
  <log>
    <verboseLogging>true</verboseLogging>
  </log>

  <warningsAllowed>
    <li>Object with load ID Thing_[^\s]+ is referenced \(xml node name: .+?\) but is not deep-saved\. This will cause errors during loading\.</li>
  </warningsAllowed>

  <preTestActions>
    <li>Vehicles.TestActions.RefocusMap</li>
  </preTestActions>
  
  <postTestActions>
    <li>Vehicles.TestActions.EmptyWorldAndMapOfVehicles</li>
    <li>Vehicles.TestActions.ClearVanillaVehiclesExpandedTrackerCache</li>
  </postTestActions>

  <map>
    <size>50</size>
  </map>
</Config>