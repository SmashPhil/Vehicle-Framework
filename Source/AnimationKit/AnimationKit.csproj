<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Smash Phil</Authors>
    <Description>Animation tool with C# frontend for Vehicle Framework.</Description>
    <Product>Animation Kit</Product>
    <RootNamespace>AnimationKit</RootNamespace>
    <AssemblyName>AnimationKit</AssemblyName>

    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Test_AnimationKit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />

    <Reference Include="CoreLib">
      <HintPath>$(OutDir)\CoreLib.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="SmashTools">
      <HintPath>$(OutDir)\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <ProjectReference Include="$(ModDir)\SmashTools\SmashTools.Analyzer\SmashTools.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>