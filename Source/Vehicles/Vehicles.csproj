<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Smash Phil</Authors>
    <Description>Framework for creating vehicles in RimWorld.</Description>
    <Product>Vehicle Framework</Product>
    <RootNamespace>Vehicles</RootNamespace>
    <AssemblyName>Vehicles</AssemblyName>
    <CurrentDate>$([System.DateTime]::Now.ToString(yyyy/MM/dd HH:mm:ss))</CurrentDate>
    <OutDir>$(ModDir)\1.7\Assemblies\</OutDir>
  </PropertyGroup>

  <!-- Version Increment -->
  <Target Name="IncrementModVersion" AfterTargets="PostBuildEvent" Condition="'$(IncrementVersion)' == 'true'">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="PowerShell.exe -ExecutionPolicy Bypass -file &quot;../../Build/IncrementVersion.ps1&quot; 1 7 &quot;07-DEC-2019&quot; -VersionFile true" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="bash &quot;../../Build/IncrementVersion.sh&quot; 1 7 &quot;07-DEC-2019&quot; true true" />
  </Target>

  <!-- Localization Files -->
  <Target Name="UpdateLocalization" AfterTargets="PostBuildEvent" Condition="'$(UpdateLocalization)' == 'true'">
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="PowerShell.exe -ExecutionPolicy Bypass -file &quot;../../Build/ExtractTranslations.ps1&quot; &quot;1.7&quot;" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="bash &quot;../../Build/ExtractTranslations.sh&quot; &quot;1.7&quot;" />
  </Target>

  <!-- AssemblyInfo -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Test_Vehicles</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Dependencies -->
  <ItemGroup>
    <!-- Nuget -->
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.3" />

    <!--Local -->
    <Reference Include="CoreLib">
      <HintPath>$(OutDir)\CoreLib.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="SmashTools">
      <HintPath>$(OutDir)\SmashTools.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="SmashTools.PathFinder">
      <HintPath>$(OutDir)\SmashTools.PathFinder.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="AnimationKit">
      <HintPath>$(OutDir)\AnimationKit.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="UpdateLogTool">
      <HintPath>$(OutDir)\UpdateLogTool.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <ProjectReference Include="$(ModDir)\Source\SmashTools.Analyzer\SmashTools.Analyzer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>