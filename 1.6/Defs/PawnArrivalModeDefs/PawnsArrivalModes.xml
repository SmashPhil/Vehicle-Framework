<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <PawnsArrivalModeDef FeatureFlag = "Paratroopers">
    <defName>ParatrooperDrop</defName>
    <workerClass>Vehicles.Raiders.PawnsArrivalModeWorker_Airdrop</workerClass>
    <layerWhitelist>
      <li>Surface</li>
    </layerWhitelist>
    <selectionWeightCurve> <!-- not usable in many strategies and by many factions, so this gets boosted -->
      <points>
        <li>(1200, 0)</li>
        <li>(2200, 4.2)</li>
      </points>
    </selectionWeightCurve>
    <selectionWeightCurvesPerFaction>
      <li>
        <faction>Mechanoid</faction>  <!-- Special case for mechanoids -->
          <selectionWeightPerPointsCurve>
            <points>
              <li>(0, 0)</li>
            </points>
        </selectionWeightPerPointsCurve>
      </li>
    </selectionWeightCurvesPerFaction>
    <pointsFactorCurve>
      <points>
        <li>0, 0.70</li>
        <li>5000, 0.45</li>
      </points>
    </pointsFactorCurve>
    <minTechLevel>Industrial</minTechLevel>
    <textEnemy>A group of {0} from {1} are parachuting nearby.</textEnemy>
    <textFriendly>A group of friendly {0} from {1} are parachuting nearby.</textFriendly>
    <textWillArrive>{0_pawnsPluralDef} will drop from above.</textWillArrive>
  </PawnsArrivalModeDef>
</Defs>
